{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mochi Island",
      "type": "shell",
      "command": "${workspaceFolder}/Scripts/build-app.sh && open ${workspaceFolder}/island/MochiIsland.app",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
